# Catálogo de variables; este archivo raíz no se carga automáticamente.
# Backend: copiar backend/.env.example a backend/.env y completar allí.
# Frontend: copiar frontend/.env.example a frontend/.env y completar allí.
# En Render, configurar los valores privados en Environment de cada servicio.
# Los valores están vacíos deliberadamente; no escribir credenciales reales aquí.

# BACKEND (backend/src/config/env.ts)
# Obligatoria: URI de MongoDB Atlas; incluir usuario/base solo en el .env privado.
MONGODB_URI=
# Opcional: nombre de base; si está vacío se usa la base de la URI.
MONGODB_DB=
# Origen exacto del cliente (protocolo, dominio y puerto), sin ruta ni barra final.
FRONTEND_URL=
# Puerto HTTP; por defecto 3000 localmente. Render proporciona PORT.
PORT=
# Entorno: development localmente o production en Render.
NODE_ENV=

# FRONTEND (frontend/src/api/cliente.ts)
# URL pública del backend terminada en /api. Vite la incorpora al compilar.
# Localmente: http://localhost:3000/api. Nunca poner secretos en variables VITE_*.
VITE_API_URL=

# HERRAMIENTAS (opcional; no requerida por el backend ni el frontend)
# Carpeta de caché de MongoDB temporal para tests y demo:memoria.
# Por defecto /tmp/diario-mongodb-binaries en las comprobaciones del proyecto.
MONGOMS_DOWNLOAD_DIR=
# Render: versión de Node usada para instalar y compilar ambos servicios.
# render.yaml fija la versión compatible; el desarrollo usa Node >=22.12.
NODE_VERSION=
