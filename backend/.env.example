# Copiar a .env. Completar con la URI de tu base de datos (no versionar credenciales).
MONGODB_URI=
# Opcional: selecciona la base; si se omite o queda vacío se usa la indicada por la URI.
MONGODB_DB=
# Origen exacto del frontend: protocolo y dominio/puerto, sin barra final.
FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
